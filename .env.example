PORT=3000
# En desarrollo, cambia a true si Ollama está instalado y ejecutándose.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=gemma3:1b

# Orígenes externos autorizados para consumir la API, separados por coma.
# Déjalo vacío si la interfaz y la API se sirven desde el mismo Express.
# Ejemplo: ALLOWED_ORIGINS=https://mi-frontend.netlify.app
ALLOWED_ORIGINS=
